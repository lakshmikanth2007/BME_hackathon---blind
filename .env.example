# EyeSight environment variables
# Copy to .env and fill in. Never commit .env.

# Vision-language model provider: "claude" or "gemini"
EXPO_PUBLIC_VLM_PROVIDER=claude

# API key for the chosen provider
EXPO_PUBLIC_VLM_API_KEY=

# Optional overrides
EXPO_PUBLIC_VLM_MODEL=gemini-3.8-flash
EXPO_PUBLIC_PORCUPINE_ACCESS_KEY=
